<?xml version="1.0" encoding="utf-8"?>
<!-- Fail closed: trust only Android system CAs. No user CA or cleartext exceptions.
     This policy applies to both Debug and Release; do not override it in Debug. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
